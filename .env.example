# Setările serverului. Copiați în .env (scriptul de instalare îl creează automat cu parole generate).
# NU puneți fișierul .env în git.

# Domeniul aplicației (ex. livrari.nobilprest.md) — HTTPS automat. Pentru test fără domeniu: :80
DOMAIN=:80

# Parola pentru oficiu (orice nume de utilizator) — acces la tot.
APP_PASSWORD=

# Parola pentru șoferi (utilizator: sofer) — doar pagina Șofer.
DRIVER_PASSWORD=

# Cheia pe care o primește furnizorul GPS (antet Authorization: Bearer <cheia>).
GPS_INGEST_TOKEN=

# Doar la pornire fără Docker (calculator din oficiu): unde se păstrează datele.
# DATA_DIR=./data
